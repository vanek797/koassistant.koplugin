#: koassistant_settings_schema.lua:2809
#, fuzzy
msgid ""
"Allow AI to search the web for current information.\n"
"\n"
"Supported providers: %1.\n"
"\n"
"Gemini supports it only on Search-grounding-capable models; OpenAI on GPT-5 "
