#: koassistant_settings_schema.lua:2125
#, fuzzy
msgid "Allow Advanced Stats"
msgstr "Erweiterte Statistiken erlauben"

#: koassistant_settings_schema.lua:2128
#, fuzzy
msgid ""
"Share reading engagement data with AI. Includes curated groups based on "
"reading time and completion patterns (e.g. books read extensively, stalled "
"reads, briefly started)."
msgstr ""
"Teile Leseengagement-Daten mit der KI. Enthält kuratierte Gruppen basierend "
