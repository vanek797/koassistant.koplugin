#: koassistant_settings_schema.lua:874
#, fuzzy
msgid ""
"Easy: straightforward recall. Medium: comprehension and application. Hard: "
"analysis and synthesis."
msgstr ""
"Facile : rappel direct. Moyen : compréhension et application. Difficile : "
"analyse et synthèse."

#: koassistant_settings_schema.lua:879
#, fuzzy
msgid "Include Multiple Choice"
msgstr "Inclure les QCM"

#: koassistant_settings_schema.lua:886
#, fuzzy
msgid "Include Short Answer"
msgstr "Inclure les réponses courtes"

#: koassistant_settings_schema.lua:893
